{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uttaradit-contract-number",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "uttaradit-contract-registry-db",
      "database_id": "24e5219f-d220-4a2e-b121-cae225a52589"
    }
  ]
}